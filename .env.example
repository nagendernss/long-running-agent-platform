# Plain libpq-style URL. App derives asyncpg (SQLAlchemy) and psycopg (Procrastinate) URLs from it.
DATABASE_URL=postgresql://hellocounsel:hellocounsel@localhost:5432/hellocounsel
FIELD_REGISTRY_PATH=config/field_registry.yaml

# Agent Brain: "rules" (keyword baseline, no network) or "gemini" (LLM).
# Setting GEMINI_API_KEY alone switches to gemini; AGENT_BRAIN=rules forces the baseline.
AGENT_BRAIN=rules
# One key, or several comma-separated. The brain rotates to the next one when a key
# is out of quota (429) or rejected (401/403), which beats waiting on a backoff.
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=gemini-3.6-flash
